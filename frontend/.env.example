# ==============================================================================
# DKP Innovations Frontend — Environment Variables
# ==============================================================================

# Backend API Base URL
# Local Development: leave blank to use the relative proxy or set to http://localhost:8080
# Production on Render: set to your deployed backend URL, e.g. https://dkp-backend.onrender.com
VITE_API_BASE_URL=

# Optional: Override the careers submission endpoint directly if needed
# Default: ${VITE_API_BASE_URL}/api/careers/applications
VITE_CAREERS_API_URL=
