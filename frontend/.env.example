# ==============================================================================
# DKP Innovations Frontend — Environment Variables
# ==============================================================================

# Backend API Base URL
# Local Development: leave blank to use the relative proxy or set to http://localhost:8080
# Production on Render: set to your deployed backend URL, e.g. https://dkp-backend.onrender.com
VITE_API_BASE_URL=

# Optional: Override the careers submission endpoint directly if needed
# Default: ${VITE_API_BASE_URL}/api/careers/applications
VITE_CAREERS_API_URL=

# ==============================================================================
# SEO & Canonical URL Configuration
# ==============================================================================
# Canonical Site Base URL (no trailing slash)
# Temporary deployment URL: https://dkp-innovation-preview.vercel.app
# Production custom domain (when purchased): https://www.dkpinnovations.com
VITE_SITE_URL=https://dkp-innovation-preview.vercel.app

# Search Engine Indexing Control (true / false)
# Default is true (allowed). Set to false to disallow crawlers on staging/preview builds.
VITE_ALLOW_INDEXING=true
