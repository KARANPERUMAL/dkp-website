# ==============================================================================
# DKP Innovations Backend — Environment Configuration
# Template file (.env.example). Never commit real secrets to Git.
# ==============================================================================

# Server & Hosting
SPRING_PROFILES_ACTIVE=prod
PORT=8080
FRONTEND_URL=https://dkpinnovation.com
CORS_ALLOWED_ORIGINS=https://dkpinnovation.com,https://www.dkpinnovation.com

# Neon PostgreSQL Database Configuration
# Format: jdbc:postgresql://<endpoint-id>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_neon_db_password_here
DB_POOL_SIZE=5

# Resend Email Integration
# Sign up at https://resend.com, verify domain, and generate an API key
RESEND_API_KEY=re_your_live_resend_api_key_here
MAIL_FROM=DKP Innovations <noreply@dkpinnovation.com>
CAREERS_TO=careers@dkpinnovation.com
SERVICES_TO=services@dkpinnovation.com
CONTACT_TO=info@dkpinnovation.com

# Private S3-Compatible Resume Object Storage
# Compatible with AWS S3, Cloudflare R2, MinIO, or DigitalOcean Spaces
STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=dkp-resumes-private
OBJECT_STORAGE_ACCESS_KEY=your_s3_access_key_here
OBJECT_STORAGE_SECRET_KEY=your_s3_secret_key_here

# Security & Rate Limiting
RATE_LIMIT_RPM=30
TRUSTED_PROXIES=127.0.0.1
SWAGGER_ENABLED=false
